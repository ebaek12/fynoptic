{
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.fynoptic.org" }],
      "destination": "https://fynoptic.org/$1",
      "permanent": true
    }
  ]
}
