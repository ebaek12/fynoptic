{
  "name": "fynoptic",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-public.mjs",
    "build": "astro check && astro build",
    "prepreview": "node scripts/sync-public.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{ts,astro,css,md,json}\"",
    "extract-articles": "node scripts/extract-articles.mjs && node scripts/verify-articles.mjs",
    "test:visual": "node scripts/visual-diff.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^6",
    "firebase": "^12.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/sora": "^5",
    "@fontsource/spectral": "^5",
    "@playwright/test": "^1",
    "eslint": "^9",
    "eslint-plugin-astro": "^1",
    "prettier": "^3",
    "prettier-plugin-astro": "^0",
    "typescript": "^5",
    "zod": "^3"
  }
}
