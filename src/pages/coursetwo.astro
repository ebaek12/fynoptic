---
import Base from '../layouts/Base.astro';
import CourseHeading from '../components/course/CourseHeading.astro';
import { CourseTwo } from '../components/course/CourseTwo';
import '../styles/course-one.css';
---
<Base title="Subscriptions & Memberships | Fynoptic" description="A complete one-hour course on subscription costs, trial deadlines, renewals, cancellations, and unexpected charges." canonical="/coursetwo" bodyClass="course-page">
  <CourseHeading number="02" title="Subscriptions." accent="On your terms." description="Know the real cost. Take control of renewals. Leave with a practical system for keeping what you value and cancelling what you don’t." modules={6} duration="About 60 minutes" outcome="A clear renewal plan, a documented cancellation, and the confidence to question an unexpected charge." />
  <noscript><p class="course-load-state">Turn on JavaScript to check your Course 1 progress, complete the activities, and save your place.</p></noscript>
  <CourseTwo client:load />
</Base>
