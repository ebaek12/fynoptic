---
import Base from '../layouts/Base.astro';
import { CourseOne } from '../components/course/CourseOne';
import '../styles/course-one.css';
---
<Base title="Dark Patterns: Spot Them, Stop Them | Fynoptic" description="Learn to spot misleading design, avoid unwanted charges, and keep the evidence you need to push back." canonical="/courseone" bodyClass="course-page">
  <header class="course-heading">
    <a href="/courses" class="course-back">← All courses</a>
    <p class="course-eyebrow">Course One · Self-paced · Free</p>
    <h1>Dark patterns.<br />See them coming.</h1>
    <p>From a pre-checked add-on to a cancellation that goes nowhere. Learn to spot the trick, choose your next move, and keep proof.</p>
  </header>
  <noscript><p class="course-load-state">Turn on JavaScript to take the quizzes and save your course progress.</p></noscript>
  <CourseOne client:load />
</Base>
