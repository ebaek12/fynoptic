---
import Base from '../layouts/Base.astro';
import { CourseOne } from '../components/course/CourseOne';
import CourseHeading from '../components/course/CourseHeading.astro';
import '../styles/course-one.css';
---
<Base title="Dark Patterns: How to Spot Them | Fynoptic" description="Learn to recognize misleading checkout pages, check unwanted charges, and document a complaint." canonical="/courseone" bodyClass="course-page">
  <CourseHeading number="01" title="Dark patterns." accent="How to spot them." description="Learn how preselected extras, hidden fees, and confusing cancellation screens work, and what you can do when you encounter them." modules={4} duration="Learn at your pace" outcome="The confidence to spot a misleading design, choose your next move, and keep the evidence that matters." />
  <noscript><p class="course-load-state">Turn on JavaScript to take the quizzes and save your course progress.</p></noscript>
  <CourseOne client:load />
</Base>
