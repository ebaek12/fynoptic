---
import Base from '../layouts/Base.astro';
import '../styles/practice.css';
---
<Base
  title="Practice – Fynoptic"
  description="Adaptive practice bank for Personal Finance and Economics. Pick a category and topic — difficulty adjusts as you go."
  canonical="/practice"
  ogTitle="Practice – Fynoptic"
  ogDescription="Adaptive practice bank for Personal Finance and Economics."
>
  <!-- HERO -->
  <section class="hero practice-hero" role="region" aria-labelledby="practice-heading">
    <div class="container">
      <h1 id="practice-heading">Adaptive Practice Bank</h1>
      <p class="hero-sub">
        Pick a category and topic. We’ll adjust difficulty as you go to keep the challenge just right.
      </p>
      <div class="orb orb1"></div>
      <div class="orb orb2"></div>
    </div>
  </section>

  <!-- CONTROLS (WIZARD) -->
  <div class="container">
    <div class="card practice-controls">
      <div id="practice-wizard" class="wizard" aria-live="polite" data-step="1">
        <!-- STEP 1: Category + Questions + Adaptive -->
        <section id="step-1" class="wizard-panel" aria-label="Step 1: Build your session">
          <h2 class="topics-title center">Build your session</h2>
          <div class="wizard-fields">
            <!-- Category -->
            <div>
              <label for="category" class="pc-label">Category</label>
              <select id="category" class="input">
                <option value="Personal Finance">Personal Finance</option>
                <option value="Economics">Economics</option>
              </select>
            </div>

            <!-- Questions -->
            <div>
              <label for="question-count" class="pc-label">Questions</label>
              <select id="question-count" class="input">
                <option>10</option>
                <option selected>20</option>
                <option>30</option>
                <option>40</option>
                <option>50</option>
              </select>
            </div>

            <!-- Adapt every -->
            <div id="adapt-every-field" class="pc-field">
              <label class="pc-label" for="adapt-every">Adapt every</label>
              <select id="adapt-every" aria-label="Adapt every">
                <option value="5">5 questions</option>
                <option value="10" selected>10 questions</option>
                <option value="15">15 questions</option>
                <option value="20">20 questions</option>
              </select>
            </div>

            <!-- Adaptive toggle -->
            <div id="adaptive-field" class="pc-field pc-toggle">
              <label class="pc-label" for="adaptive-toggle">Adaptive</label>
              <label class="switch" aria-label="Adaptive mode">
                <input type="checkbox" id="adaptive-toggle" checked />
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <!-- Hidden multi-select to keep the practice engine's logic unchanged -->
          <select id="topic" multiple hidden aria-hidden="true"></select>

          <div class="wizard-actions">
            <button id="wiz-next-1" class="btn btn-primary">Confirm &amp; Continue</button>
          </div>
          <p class="note tiny center">
            We’ll step up or down difficulty based on your recent accuracy.
          </p>
        </section>

        <!-- STEP 2: Units -->
        <section id="step-2" class="wizard-panel" aria-label="Step 2: Choose units" hidden>
          <h2 class="topics-title center">Choose Units</h2>

          <div id="topics-scroller" class="topics-scroller">
            <div id="topics-list" class="topics-list" aria-label="Topics" role="group"></div>
          </div>

          <div class="topics-actions center">
            <button id="topics-select-all" class="btn btn-ghost">Select all</button>
            <button id="topics-clear" class="btn btn-ghost">Clear</button>
          </div>

          <div class="wizard-actions">
            <button id="wiz-back-2" class="btn btn-ghost">Back</button>
            <button id="wiz-next-2" class="btn btn-primary">Confirm Units</button>
          </div>
        </section>

        <!-- STEP 3: Start -->
        <section id="step-3" class="wizard-panel" aria-label="Step 3: Start practice" hidden>
          <h2 class="topics-title center">Ready to start?</h2>
          <h3 class="topics-title center">Right-click to cross out answers</h3>
          <p id="wiz-summary" class="muted center"></p>

          <div class="wizard-actions">
            <button id="wiz-back-3" class="btn btn-ghost">Back</button>
            <button id="start-btn" class="btn btn-primary">Start Practice</button>
            <button id="reset-btn" class="btn btn-ghost">Reset</button>
          </div>
        </section>
      </div>
    </div>

    <!-- Progress + Stats -->
    <div class="card progress-card">
      <div class="pc-progress" aria-hidden="true">
        <span class="pc-progress-fill" id="pc-progress-fill" style="--p:0%"></span>
      </div>
      <div class="pc-stats" id="pc-stats" aria-live="polite" style="margin-top:.5rem">
        <span><strong id="stat-answered">0</strong>/<span id="stat-total">0</span> answered</span>
        <span class="sep">•</span>
        <span>Correct: <strong id="stat-correct">0</strong></span>
        <span class="sep">•</span>
        <span>Streak: <strong id="stat-streak">0</strong></span>
        <span class="sep">•</span>
        <span>Difficulty: <strong id="stat-diff">—</strong></span>
      </div>
    </div>

    <!-- Stage -->
    <div class="card stage" id="stage">
      <div id="stage-empty" class="empty">
        Choose a category and topic(s), then press <strong>Start Practice</strong>.
      </div>

      <div id="stage-qwrap" class="hide">
        <div class="stage-top">
          <span class="chip" id="chip-category">—</span>
          <span class="chip" id="chip-topic">—</span>
          <span class="chip" id="chip-diff">—</span>
        </div>

        <p class="prompt-label">Question</p>
        <div id="prompt" class="prompt-text">—</div>

        <div id="mc-area" class="mc-area"></div>

        <div id="feedback" class="feedback" hidden></div>

        <div class="q-actions">
          <button id="prev-btn" class="btn btn-ghost">Prev</button>
          <button id="next-btn" class="btn btn-ghost">Next</button>
          <button id="submit-btn" class="btn btn-primary">Submit</button>
          <button id="end-session-btn" class="btn btn-ghost">End Session</button>
        </div>
      </div>

      <div id="stage-finish" class="hide">
        <h3>Nice work! 🎉</h3>
        <p id="finish-summary" class="muted"></p>
        <div class="finish-actions">
          <button id="restart-btn" class="btn btn-primary">Restart</button>
          <button id="finish-reset-btn" class="btn btn-ghost">Reset</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modals -->
  <div id="fixit-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="fixit-title"></div>
  <div id="report-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="report-title"></div>
  <div id="writer-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="writer-title"></div>

  <!-- End Session Summary Modal -->
  <div id="end-session-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="end-session-title">
    <div class="dialog" role="document">
      <button class="modal-close" id="end-session-close" aria-label="Close">&times;</button>
      <h2 id="end-session-title">Session Summary</h2>
      <div id="end-session-stats" class="session-stats"></div>
    </div>
  </div>

  <script>
    import { initPractice } from '../islands/practice';

    document.addEventListener('DOMContentLoaded', () => {
      initPractice();
    });
  </script>
</Base>
