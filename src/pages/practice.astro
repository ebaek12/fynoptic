---
import Base from '../layouts/Base.astro';
import '../styles/practice.css';
import '../styles/study-setup.css';
import '../styles/study-session.css';
import { Practice } from '../components/practice/Practice';
---
<Base
  title="Practice – Fynoptic"
  description="Practice finance and economics questions by topic. The difficulty adjusts to your answers."
  canonical="/practice"
  bodyClass="practice-shell"
  ogTitle="Practice – Fynoptic"
  ogDescription="Finance and economics quizzes with answer explanations."
>
  <!-- HERO -->
  <section class="hero practice-hero page-heading" role="region" aria-labelledby="practice-heading">
    <div class="container">
      <h1 id="practice-heading">Practice</h1>
      <p class="hero-sub">
        Choose a topic, answer questions, and review the explanations.
      </p>
    </div>
  </section>

  <!-- Wizard, progress/stage cards, and the end-session modal (O7) are all
       <Practice client:load /> - see src/components/practice/Practice.tsx.
       client:load, not client:visible: this is the entire point of the
       page and sits above the fold on every viewport. -->
  <Practice client:load />
</Base>
