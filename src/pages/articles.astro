---
import Base from "../layouts/Base.astro";
import { ARTICLE_META } from "../data/articles";
import { computeReadMins, deriveBlurb } from "../lib/article-summary";
import { ArticlesBrowser } from "../components/articles/ArticlesBrowser";
import "../styles/articles.css";

const bodies = import.meta.glob("../articles/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const cards = ARTICLE_META.map((a) => {
  const body = bodies[`../articles/${a.id}.html`];
  if (typeof body !== "string")
    throw new Error(`missing article body for id: ${a.id}`);
  return { ...a, blurb: deriveBlurb(body), readMins: computeReadMins(body) };
});
---

<Base
  title="Articles & Guides — Fynoptic"
  description="Read Fynoptic articles & guides to spot and stop predatory fees, dark patterns, and subscription traps."
  canonical="/articles"
  ogTitle="Articles & Guides — Fynoptic"
  ogDescription="Know the playbook. Beat the traps."
  bodyClass="article-library"
>
  <section
    class="articles-hero container page-heading"
    aria-labelledby="articles-heading"
  >
    <h1 id="articles-heading">Articles & Guides</h1>
    <p>Practical guides to scams, hidden fees, and your consumer rights.</p>
  </section>

  <section class="container articles-results" aria-label="Article results">
    <div id="controls-sentinel" aria-hidden="true"></div>
    <div class="controls">
      <div class="controls-row">
        <div class="search-wrap" role="search" aria-label="Search articles">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"
            ></path></svg
          >
          <label for="search-input" class="sr-only">Search articles</label>
          <input
            id="search-input"
            type="search"
            placeholder="Search titles and summaries…"
            aria-describedby="search-hint"
            autocomplete="off"
          />
          <span id="search-hint" class="kbd" aria-label="Press slash to search"
            >/</span
          >
        </div>
        <div class="sort">
          <label for="sort-select" class="sr-only">Sort articles</label>
          <select id="sort-select">
            <option value="featured">Featured Order</option>
            <option value="az">Title A–Z</option>
            <option value="za">Title Z–A</option>
            <option value="short">Shortest Read</option>
            <option value="long">Longest Read</option>
          </select>
          <button
            type="button"
            id="unread-toggle"
            class="chip"
            aria-pressed="false">Unread Only</button
          >
        </div>
      </div>
    </div>

    <div class="articles-results-meta">
      <span
        class="result-count"
        id="result-count"
        aria-live="polite"
        aria-atomic="true">{cards.length} results</span
      >
    </div>

    <div id="articles-grid" class="articles-grid">
      {
        cards.map((a) => (
          <a
            class="article-card"
            href={`/articles/${a.id}`}
            data-title={a.title}
            data-blurb={a.blurb}
            data-read={String(a.readMins)}
          >
            <div class="art-meta">
              <span>{a.readMins} min read</span>
              <span class="art-read-badge">
                <span aria-hidden="true">✓</span> Read
              </span>
            </div>
            <div class="art-copy">
              <h2 class="art-title">{a.title}</h2>
              <p class="art-blurb">{a.blurb}</p>
            </div>
            <svg
              class="art-arrow"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path d="M4 12h16m-7-7 7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </div>

    <div id="empty-state" class="articles-empty" hidden>
      <h2>No matching articles</h2>
      <p>Try a different search or clear your filters.</p>
      <button type="button" id="clear-filters" class="articles-button"
        >Clear Search</button
      >
    </div>
    <div class="articles-more">
      <button
        type="button"
        id="load-more"
        class="articles-button"
        aria-label="Load more articles"
        >Load more articles <span aria-hidden="true">↓</span></button
      >
    </div>
  </section>

  <ArticlesBrowser client:load />
  <button class="float-top" id="float-top" aria-label="Back to top">↑</button>

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Fynoptic Articles & Guides",
      "isPartOf": { "@type": "WebSite", "name": "Fynoptic" },
      "about": [
        "Consumer protection",
        "Fees",
        "Subscriptions",
        "BNPL",
        "Disputes",
        "Privacy"
      ]
    }
  </script>
  <script>
    import { initBackToTop } from "../lib/back-to-top";
    document.addEventListener("DOMContentLoaded", initBackToTop);
  </script>
</Base>
