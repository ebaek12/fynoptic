---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero';
import MagnifierScrollZoom from '../components/ui/magnifier-scroll-zoom';
import SpotTheRedFlag from '../components/home/SpotTheRedFlag';
import CurriculumStrip from '../components/home/CurriculumStrip.astro';
import HomeClosing from '../components/home/HomeClosing.astro';
import '../styles/home-hero.css';
---
<Base
  title="Take your first step towards financial freedom."
  description="Fynoptic helps people identify and avoid junk fees, dark patterns, and subscription traps before they cost you money."
  canonical="/"
  ogTitle="Fynoptic"
  ogDescription="Understand the tactics. Avoid the traps."
  bodyClass="home-page"
>
  <!-- HERO -->
  <section class="hero home-hero page-heading" role="region" aria-labelledby="hero-heading">

    <div class="container hero-content">
      <Hero client:load />
    </div>
  </section>

  <MagnifierScrollZoom client:load />

  <SpotTheRedFlag client:visible />
  <CurriculumStrip />
  <HomeClosing />

  <!-- Modals -->
  <div id="report-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="report-title"></div>
  <div id="writer-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="writer-title"></div>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline>
    { "@context": "https://schema.org", "@type": "Course", "name": "Fynoptic Core Modules", "provider": { "@type": "Organization", "name": "Fynoptic" } }
  </script>

  <!-- `page-loaded` + initReveal() moved to Base.astro so every page gets
       scroll-triggered reveals, not just this one. -->
</Base>
