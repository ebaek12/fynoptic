---
import Base from '../layouts/Base.astro';
import '../styles/courses.css';
import { CourseCatalog } from '../components/course/CourseCatalog';
import { COURSE_CATALOG } from '../data/course-catalog';
const cards = COURSE_CATALOG.map(({ modules, headline, accent, outcome, skillsTitle, assessment, ...course }) => ({ ...course, moduleCount: modules.length }));
---
<Base title="Courses | Fynoptic" description="Free lessons on misleading checkout pages, unwanted charges, and consumer rights." canonical="/courses">
  <section class="course-library page-heading container" aria-labelledby="courses-hero-title">
    <h1 id="courses-hero-title">Courses</h1>
    <p class="library-intro">Learn what to check before you buy, subscribe, or share your details.</p>
    <CourseCatalog courses={cards} client:load />
    <p class="library-footnote">Course progress saves on your device. <a href="/articles">Browse the articles</a> for more on each topic.</p>
  </section>
</Base>
