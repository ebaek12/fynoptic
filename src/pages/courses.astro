---
import Base from '../layouts/Base.astro';
import '../styles/courses.css';

const lockedCourses = [
  ['Subscriptions & Memberships', 'Defense in 4 Steps'],
  ['Disputes & Refunds', 'From “Stuck” to Credited'],
  ['Money Skills for Students', 'Campus & App Pitfalls'],
  ['AI Scams & Deepfakes', 'Spot the Synthetic Tricks Fast'],
  ['Privacy Permissions', 'Take Back Control of Your Data'],
  ['Ad Transparency', 'Decode Ads, Influencers, and Algorithms'],
  ['Chargeback Playbook', 'How to Win When Merchants Push Back'],
];
---
<Base title="Courses | Fynoptic" description="Practical lessons on deceptive design, consumer rights, and everyday money decisions." canonical="/courses">
  <section class="course-library page-heading container" aria-labelledby="courses-hero-title">
    <h1 id="courses-hero-title">Courses</h1>
    <p class="library-intro">Learn to spot the traps behind everyday financial decisions.</p>
    <div id="catalog" class="library-grid">
      <article class="library-card library-card--available" data-course-id="dark-patterns">
        <div class="library-card-top"><span>Course 01</span><span class="library-available">Available now</span></div>
        <h2>Dark Patterns</h2>
        <p class="library-subtitle">Spot Them, Stop Them</p>
        <p class="library-description">Recognize deceptive design, practice spotting it, and build your own risk audit.</p>
        <div class="library-card-bottom">
          <p class="library-format">4 modules · Self-paced</p>
          <a class="btn btn-primary" href="/courseone" data-track="cta_click" aria-label="Open course Dark Patterns: Spot Them, Stop Them">Open Course <span aria-hidden="true">→</span></a>
        </div>
      </article>
      {lockedCourses.map(([title, subtitle], index) => (
        <article class="library-card library-card--locked" aria-describedby={`course-lock-${index + 2}`}>
          <div class="library-card-top"><span>Course {String(index + 2).padStart(2, '0')}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
          <h2>{title}</h2>
          <p class="library-subtitle">{subtitle}</p>
          <div class="library-card-bottom" id={`course-lock-${index + 2}`}>
            <p class="library-lock">Available After Completing Course {index + 1}</p>
            <p class="library-lock-hint">Course {index + 1} not started</p>
          </div>
        </article>
      ))}
    </div>
    <p class="library-footnote">Course progress saves on your device. <a href="/articles">Explore the reading library</a> for more on each topic.</p>
  </section>
</Base>
