---
import Base from '../layouts/Base.astro';
import '../styles/flashcards.css';
import '../styles/study-setup.css';
import { Flashcards } from '../components/flashcards/Flashcards';
---
<Base
  title="Flashcards • Fynoptic"
  description="Review and master financial literacy vocabulary with interactive flashcards."
  canonical="/flashcard"
  ogTitle="Fynoptic – Flashcards"
  ogDescription="Review and master financial literacy vocabulary with interactive flashcards."
>
  <!-- flashcards-shell wraps this page's content so the .flashcards-shell
       descendant selectors in legacy.css (.fc-controls, .fc-grid,
       .mode-chip, .fc-stage.card, etc.) still match — Base.astro's <main>
       can't carry this class since it's shared across every page. -->
  <div class="flashcards-shell page-heading">
    <section class="container">
      <h1>Flashcards</h1>
      <p class="lead">Get familiar with the terms. Make the knowledge stick.</p>

      <!-- <Flashcards client:load /> — see src/components/flashcards/Flashcards.tsx.
           client:load, not client:visible: this is the entire point of the
           page and sits above the fold. It owns the wizard, the in-session
           stage, the reset-progress dialog and the summary modal. -->
      <Flashcards client:load />
    </section>
  </div>
</Base>
