---
import "../../styles/curriculum-strip.css";

// Each topic opens existing learning material rather than an empty category.
const topics = [
  {
    title: "Phishing",
    href: "/articles/unauthorized-vs-authorized-tricked",
    icon: "M3 5h18v14H3z M3 5l9 7 9-7 M12 14v2",
  },
  {
    title: "Dark Patterns",
    href: "/courseone",
    icon: "M5 3v17l5-5 4 6 3-2-4-6h7L5 3Z",
  },
  {
    title: "Hidden Fees",
    href: "/articles/all-in-pricing-fee-transparency",
    icon: "M5 3h14v18l-3-2-4 2-4-2-3 2V3Z M9 7h6 M9 11h6 M9 15h3",
  },
  {
    title: "Investment Scams",
    href: "/flashcard#unit-protecting-your-money-and-identity",
    icon: "M3 18l6-7 4 3 8-10 M14 4h7v7 M3 22h18",
  },
  {
    title: "Identity Theft",
    href: "/articles/breach-response-freezes-monitoring-fraud-alerts-identity-recovery",
    icon: "M12 3 3 7v5c0 5 9 10 9 10s9-5 9-10V7l-9-4Z M9 10a3 3 0 1 0 6 0 3 3 0 1 0-6 0 M7 17c1-4 9-4 10 0",
  },
  {
    title: "Subscription Traps",
    href: "/articles/how-to-protect-yourself-from-subscription-creep",
    icon: "M20 7H8a5 5 0 0 0-5 5 M16 3l4 4-4 4 M4 17h12a5 5 0 0 0 5-5 M8 13l-4 4 4 4",
  },
  {
    title: "Payment Scams",
    href: "/articles/venmo-cash-app-zelle-what-happens-when-something-goes-wrong",
    icon: "M3 5h18v14H3z M3 10h18 M7 15h3 M16 14v2",
  },
];
---

<section id="curriculum" class="curriculum-strip" aria-labelledby="curriculum-heading">
  <div class="curriculum-container">
    <div class="curriculum-header">
      <h2 id="curriculum-heading">
        A few things we cover <span aria-hidden="true">→</span>
      </h2>
      <div class="curriculum-controls" hidden>
        <button
          type="button"
          data-direction="previous"
          aria-label="Previous topics"
          aria-controls="curriculum-topics"
          disabled
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M19 12H5m6-6-6 6 6 6"></path></svg
          >
        </button>
        <button
          type="button"
          data-direction="next"
          aria-label="Next topics"
          aria-controls="curriculum-topics"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
          >
        </button>
      </div>
    </div>
    <div
      class="curriculum-scroll"
      id="curriculum-topics"
      role="region"
      aria-label="Learning topics"
      tabindex="0"
    >
      <ul class="curriculum-topics">
        {
          topics.map((topic) => (
            <li>
              <a class="curriculum-topic" href={topic.href}>
                <svg
                  class="curriculum-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d={topic.icon} />
                </svg>
                <span>{topic.title}</span>
                <svg
                  class="curriculum-link-arrow"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="m6 18 12-12M6 6h12v12" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const strip = document.querySelector<HTMLElement>(".curriculum-strip");
  const scroller = strip?.querySelector<HTMLElement>(".curriculum-scroll");
  const controls = strip?.querySelector<HTMLElement>(".curriculum-controls");
  const previous = strip?.querySelector<HTMLButtonElement>(
    '[data-direction="previous"]',
  );
  const next = strip?.querySelector<HTMLButtonElement>(
    '[data-direction="next"]',
  );

  if (scroller && controls && previous && next) {
    const update = () => {
      const end = scroller.scrollWidth - scroller.clientWidth;
      controls.hidden = end <= 1;
      previous.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= end - 1;
    };
    const move = (direction: number) => {
      scroller.scrollBy({
        left: direction * scroller.clientWidth * 0.7,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
      });
    };
    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    scroller.addEventListener("scroll", update, { passive: true });
    const observer = new ResizeObserver(update);
    observer.observe(scroller);
    const topics = scroller.querySelector("ul");
    if (topics) observer.observe(topics);
    document.fonts.ready.then(update);
    update();
  }
</script>
