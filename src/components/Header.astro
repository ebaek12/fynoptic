---
// Verified identical across all 9 pages in the auth-overhaul worktree
// (about.html, index.html, flashcard.html spot-checked byte-for-byte
// structurally). #user-btn's two children and its data-modal-open attribute
// are load-bearing — see src/lib/auth.ts and css/redesign.css's
// .user-icon[data-modal-open] glyph rule. Never write innerHTML on #user-btn.
---
<header class="header" role="banner">
  <nav class="nav container" role="navigation" aria-label="Main navigation">
    <a href="/" class="logo" aria-label="Fynoptic Home">
      <img src="/assets/img/fynopticlogo.png" alt="Fynoptic logo" />
      <span class="logo-text">Fynoptic</span>
    </a>

    <button id="nav-toggle" class="nav-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
      <span aria-hidden="true" class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </button>

    <ul class="nav-links" id="desktop-nav">
      <li><a href="/courses">Course</a></li>
      <li><a href="/articles">Articles</a></li>
      <li><a href="/flashcard">Flashcards</a></li>
      <li><a href="/practice">Practice</a></li>
      <li><a href="/about">About</a></li>
    </ul>

    <div class="nav-actions">
      <a href="/courses" class="btn btn-primary cta-desktop" data-track="cta_click">Start the free course</a>
      <button id="user-btn" class="user-icon" aria-label="Sign in" data-modal-open="login-modal">
        <img id="nav-avatar" alt="" hidden />
        <span id="nav-initials" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <button class="menu-close" aria-label="Close menu">&times;</button>
    <ul>
      <li><a href="/courses">Course</a></li>
      <li><a href="/articles">Articles</a></li>
      <li><a href="/flashcard">Flashcards</a></li>
      <li><a href="/practice">Practice</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/courses" class="btn btn-primary" data-track="cta_click">Start the free course</a></li>
    </ul>
  </div>
</header>
