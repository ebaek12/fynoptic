---
import '@fontsource-variable/inter';
import '@fontsource/spectral/600.css';
import '../styles/legacy.css';
import '../styles/redesign.css';
import '../styles/globals.css';
import '../styles/interface.css';
import '../styles/auth.css';
import SiteBg from '../components/SiteBg.astro';
import { Nav } from '../components/shell/Nav';
import { Footer } from '../components/shell/Footer';
import { Toaster } from '../components/shell/Toaster';
import { AuthDialog } from '../components/auth/AuthDialog';

interface Props {
  title: string;
  description: string;
  /** Extensionless, site-relative, e.g. "/about" or "/" for the homepage. */
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://fynoptic.org/assets/img/fynopticlogo.png',
  bodyClass,
} = Astro.props;

const canonicalUrl = new URL(canonical, 'https://fynoptic.org').toString();
---

<!DOCTYPE html>
<html lang="en" class="no-js" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    (function () {
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('page-loaded');
      try {
        var theme = localStorage.getItem('fynoptic-theme');
        document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F7F9FC" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Icons — identical on every page -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/assets/icons/favicon-96x96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>
</head>
<body class={bodyClass}>
  <script is:inline>
    document.body.setAttribute('data-theme', document.documentElement.getAttribute('data-theme') || 'light');
  </script>
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteBg />
  <Nav client:load />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Toaster client:load />
  <Footer />
  <AuthDialog client:load />

  <script>
    import { initModals } from '../lib/modal';
    import { applyA11y } from '../lib/a11y';
    import { initReveal } from '../lib/reveal';

    document.addEventListener('DOMContentLoaded', () => {
      applyA11y();
      initModals();
      initReveal();
    });
  </script>
</body>
</html>
